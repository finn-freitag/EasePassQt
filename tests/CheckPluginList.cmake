# Every entry of plugins/PluginList.json has its package next to it, and the package's
# SHA-256 is the one in the list (steps.txt T29). Usage:
#   cmake -DPLUGINS_DIR=<repo>/plugins -P CheckPluginList.cmake
file(READ "${PLUGINS_DIR}/PluginList.json" list)
string(JSON count LENGTH "${list}" plugins)
if(count EQUAL 0)
    message(FATAL_ERROR "PluginList.json lists no plugins")
endif()
math(EXPR last "${count} - 1")
set(listed)
foreach(index RANGE ${last})
    string(JSON id GET "${list}" plugins ${index} id)
    string(JSON expected GET "${list}" plugins ${index} sha256)
    string(JSON url GET "${list}" plugins ${index} download_url)
    set(package "${PLUGINS_DIR}/${id}.epplugin")
    if(NOT EXISTS "${package}")
        message(FATAL_ERROR "${id}: plugins/${id}.epplugin is missing")
    endif()
    file(SHA256 "${package}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${id}: the list says ${expected}, the package has ${actual}")
    endif()
    if(NOT url MATCHES "^https://github\\.com/finn-freitag/[A-Za-z0-9_-]+/releases/download/v[0-9.]+/${id}\\.epplugin$")
        message(FATAL_ERROR "${id}: unexpected download_url ${url}")
    endif()
    list(APPEND listed "${id}.epplugin")
endforeach()
# No package without an entry either.
file(GLOB packages RELATIVE "${PLUGINS_DIR}" "${PLUGINS_DIR}/*.epplugin")
foreach(package IN LISTS packages)
    if(NOT package IN_LIST listed)
        message(FATAL_ERROR "plugins/${package} is not in PluginList.json")
    endif()
endforeach()
message(STATUS "${count} plugins, hashes match")
